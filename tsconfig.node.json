{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // scripts/migrations.test.ts imports the pure selection helpers straight from
    // migrate-dev.mjs so the test exercises the real implementation rather than a copy.
    // Their types come from JSDoc on those exports.
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vite.docsCapture.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "scripts/migrate-dev.mjs"
  ]
}
