{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "dev-docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DOCS_CAPTURE=1 npm run dev -- --port 5190 --strictPort"
      ],
      "port": 5190
    }
  ]
}
