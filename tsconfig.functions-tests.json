{
  "extends": "./tsconfig.functions.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions-tests.tsbuildinfo",
    "lib": ["ES2024"],
    "jsx": "react-jsx",
    "erasableSyntaxOnly": false,
    "allowJs": true,
    "types": ["vite/client", "vitest/globals", "node", "@cloudflare/workers-types"]
  },
  "include": ["functions/**/*.test.ts", "workers/**/*.test.ts"],
  "exclude": ["functions/domain", "functions/config", "functions/**/*.client.*.test.ts",
    "functions/_shared/loadDataset.scaling.test.ts",
    "functions/_shared/dbUsage.parity.test.ts"
  ],
  "files": []
}
